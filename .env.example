# Copy to .env and fill in what you need: cp .env.example .env
# scripts/run.sh loads .env for every process it starts. Anything you export in your
# shell wins over .env. For scripts you run yourself (beat.py, plan_follow_ups.py),
# load it in that terminal first: set -a; . ./.env; set +a
#
# With no .env at all, the demo runs in mock mode on a local dev server: no keys.

# --- Temporal connection ---------------------------------------------------------
# local: the dev server that run.sh starts on localhost:7233.
# cloud: Temporal Cloud, from the three values below. Start with ./scripts/run.sh --cloud
# The client reads TEMPORAL_ADDRESS whenever it is set, so leave these three commented
# out for local mode in any terminal that loads this file.
TEMPORAL_TARGET=local
# Your Namespace endpoint, for example <region>.<cloud>.api.temporal.io:7233
# TEMPORAL_ADDRESS=<your-region-endpoint>:7233
# Your Namespace id, in the form <namespace>.<account-id>
# TEMPORAL_NAMESPACE=<your-namespace>.<your-account-id>
# A Temporal Cloud API key with access to that Namespace. Keep it secret.
# TEMPORAL_API_KEY=<your-api-key>
# Optional: the client and Worker identity shown in the Temporal UI and the dashboard.
# TEMPORAL_IDENTITY=<a-name-for-this-machine>

# --- Model -------------------------------------------------------------------------
# mock (default, no keys), bedrock (Amazon Bedrock) or anthropic (Anthropic API).
MODEL_MODE=mock
# bedrock: AWS credentials come from the standard chain (AWS_PROFILE, keys, or a role).
AWS_REGION=us-east-1
# AWS_PROFILE=<your-aws-profile>
# A Bedrock model id or inference profile id your account can use. Unset: the Strands default.
# BEDROCK_MODEL_ID=<bedrock-model-or-inference-profile-id>
# anthropic: an Anthropic API key and, optionally, a model id.
# ANTHROPIC_API_KEY=<your-anthropic-api-key>
# ANTHROPIC_MODEL_ID=<anthropic-model-id>

# --- Skills ------------------------------------------------------------------------
# mock (default) returns canned data. live calls a real backend (not part of this demo).
SKILLS_MODE=mock

# --- Task Queues (optional) --------------------------------------------------------
# Defaults: agent-session and model-calls. Set both to run a second copy of the demo on
# a shared Namespace with its own Worker pool. Every process must see the same values.
# TASK_QUEUE_AGENT=agent-session
# TASK_QUEUE_MODEL=model-calls

# --- Demo tuning (optional) --------------------------------------------------------
# Seconds until an armed follow-up fires. Default: three days (259200). beat.py 5 uses 3
# unless you set it. Keep it at 30 or less for beat.py 5 --kill (see the README).
# FOLLOW_UP_DELAY=20
# on: publish the NextFollowUpAt Search Attribute (run.sh turns it on locally). On Temporal
# Cloud, register the attribute on your Namespace first.
# FOLLOW_UP_SEARCH_ATTRIBUTE=on
# Task Queue-wide cap on model calls, in Activities per second. Default 1000.
# MODEL_QUEUE_RPS=2
# Mock latency in milliseconds. The defaults (4000 and 2500) leave time for a Ctrl-C.
# MOCK_SKILL_LATENCY_MS=4000
# MOCK_MODEL_LATENCY_MS=2500
# Where send_customer_message posts. run.sh points it at the gateway stub.
# OUTBOUND_URL=http://127.0.0.1:8090/outbound
# GATEWAY_URL=http://127.0.0.1:8090
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8090
# HARNESS0_URL=http://127.0.0.1:8091
# HARNESS1_URL=http://127.0.0.1:8092
# HARNESS_PORT=8091

# --- Hosting (optional) ------------------------------------------------------------
# local (default). agentcore is served by scripts/runtime.py, not run.sh.
RUNTIME_HOST=local
# agentcore: the dashboard WORKER lane shows the serverless drain framing.
# WORKER_MODE=local

# --- AgentCore Runtime (Pre-release; see deploy/agentcore/README.md) ---------------
# Worker Versioning for Serverless Workers. Leave unset for the local demo.
# TEMPORAL_DEPLOYMENT_NAME=durable-agent-demo
# TEMPORAL_BUILD_ID=v1
# Seconds the ephemeral Worker keeps polling after it goes idle.
# AGENTCORE_DEBOUNCE_SECONDS=<seconds>
# Used by the deploy scripts:
# EXECUTION_ROLE_ARN=<execution-role-arn>
# IMAGE_URI=<ecr-image-uri>
# RUNTIME_ID=<agentcore-runtime-id>
# DEPLOYMENT_NAME=durable-agent-demo
# BUILD_ID=v1
# EXTERNAL_ID=<an-external-id-you-choose>
# INVOKE_STACK=temporal-agentcore-invoke
# ASSUME_ROLE_ARN=<invoke-role-arn>
# AWS_PARTITION=aws
